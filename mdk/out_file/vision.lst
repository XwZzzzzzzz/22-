 1024          void middle_line_update(void)
 1025          {
 1026   1          int r;
 1027   1          for( r = start_row ; r>=end_row;r--)
 1028   1          {
 1029   2              middle_line[r].row=r;
 1030   2      
 1031   2              if(L_edge[r].flag==hit || R_edge[r].flag==hit)              /* 至少一边命中：开始更新 
             -*/
 1032   2              {
 1033   3                  middle_line[r].col=(int)(R_edge[r].col+ L_edge[r].col)/2;
 1034   3                  middle_line[r].flag = hit;
 1035   3              }
 1036   2              else if(L_edge[r].flag==lost && R_edge[r].flag==lost)       /* 两边都丢：继承更近一行 
             -*/
 1037   2              {
 1038   3                  if(r < start_row) middle_line[r].col = middle_line[r+1].col;
 1039   3                  else              middle_line[r].col = middle_col;      /* 最后一行没有更近行，用�
             -��子列兜底 */
 1040   3                  middle_line[r].flag = lost;
 1041   3              }
 1042   2              else if(R_edge[r].flag==wait || L_edge[r].flag==wait)                 /* 含 wait：还没扫到�
             -��直接不管 */
 1043   2              {
 1044   3                  middle_line[r].flag=wait;
 1045   3              }
 1046   2          }
 1047   1      }
