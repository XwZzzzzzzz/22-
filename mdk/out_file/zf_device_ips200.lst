  491          void ips200_show_chinese (uint16 x, uint16 y, uint8 siz, const uint8 *p, uint8 number, uint16 color)
  492          {
  493   1        int i, j, k; 
  494   1          uint8 temp, temp1, temp2;
  495   1          const uint8 *p_data;
  496   1        
  497   1          zf_assert(x < ips200_x_max);
  498   1          zf_assert(y < ips200_y_max);
  499   1      
  500   1          temp2 = siz/8;
  501   1          
  502   1          ips200_set_region(x,y,number*siz-1+x,y+siz-1);
  503   1          
  504   1          for(i=0;i<siz;i++)
  505   1          {
  506   2              temp1 = number;
  507   2              p_data = p+i*temp2;
  508   2              while(temp1--)
  509   2              {
  510   3                  for(k=0;k<temp2;k++)
  511   3                  {
  512   4                      for(j=8;j>0;j--)
  513   4                      {
  514   5                          temp = (*p_data>>(j-1)) & 0x01;
  515   5                          if(temp)    ips200_write_16bit_data(color);
  516   5                          else        ips200_write_16bit_data(ips200_bgcolor);
  517   5                      }
  518   4                      p_data++;
  519   4                  }
  520   3                  p_data = p_data - temp2 + temp2*siz;
  521   3              }   
  522   2          }
  523   1      }
