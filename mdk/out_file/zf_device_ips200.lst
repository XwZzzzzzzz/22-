  543          void ips200_show_gray_image (uint16 x, uint16 y, const uint8 *image, uint16 width, uint16 height, uint16 
             -dis_width, uint16 dis_height, uint8 threshold)
  544          {
  545   1          uint32 i = 0, j = 0;
  546   1          uint16 color ,temp ;
  547   1          uint16 data_buffer[IPS_LEN];
  548   1          const uint8 *image_temp;
  549   1      
  550   1          // Èç¹û³ÌÐòÔÚÊä³öÁË¶ÏÑÔÐÅÏ¢ ²¢ÇÒÌáÊ¾³ö´íÎ»ÖÃÔÚÕâÀï
  551   1          // ÄÇÃ´Ò»°ãÊÇÆÁÄ»ÏÔÊ¾µÄÊ±ºò³¬¹ýÆÁÄ»·Ö±æÂÊ·¶Î§ÁË
  552   1          zf_assert(x < ips200_x_max);
  553   1          zf_assert(y < ips200_y_max);
  554   1          zf_assert(NULL != image);
  555   1      
  556   1          IPS200_CS(0);
  557   1      
  558   1          ips200_set_region(x, y, x + dis_width - 1, y + dis_height - 1);             // ÉèÖÃÏÔÊ¾ÇøÓò
  559   1      
  560   1          for(j = 0; j < dis_height; j ++)
  561   1          {
  562   2              image_temp = image + j * height / dis_height * width;                   // Ö±½Ó¶Ô image ²Ù×÷»á Ha
             -rdfault ÔÝÊ±²»ÖªµÀÎªÊ²Ã´
  563   2              for(i = 0; i < dis_width; i ++)
  564   2              {
  565   3                  temp = *(image_temp + i * width / dis_width);                       // ¶ÁÈ¡ÏñËØµã
  566   3                  if(threshold == 0)
  567   3                  {
  568   4                      color = (0x001f & ((temp) >> 3)) << 11;
  569   4                      color = color | (((0x003f) & ((temp) >> 2)) << 5);
  570   4                      color = color | (0x001f & ((temp) >> 3));
  571   4                      data_buffer[i] = (color);
  572   4                  }
  573   3                  else if(temp < threshold)
  574   3                  {
  575   4                      data_buffer[i] = (RGB565_BLACK);
  576   4                  }
  577   3                  else
  578   3                  {
  579   4                      data_buffer[i] = (RGB565_WHITE);
  580   4                  }
  581   3              }
  582   2              ips200_write_16bit_data_array(data_buffer, dis_width);
  583   2          }
  584   1      
  585   1          IPS200_CS(1);
  586   1      
  587   1      }
