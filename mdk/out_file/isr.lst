  267          void DMA_UART1_IRQHandler(void) interrupt DMA_UR1R_VECTOR
  268          {
  269   1          static vuint8 dwon_count = 0;
  270   1      
  271   1          if (DMA_UR1R_STA & 0x01) // 接收完成
  272   1          {
  273   2              DMA_UR1R_STA &= ~0x01;      // 清标志位
  274   2              uart_rx_start_buff(UART_1); // 设置下一次接收，务必保留
  275   2      
  276   2              // 程序自动下载
  277   2              if (uart_rx_buff[UART_1][0] == 0x7F)
  278   2              {
  279   3                  if (dwon_count++ > 20)
  280   3                  {
  281   4                      IAP_CONTR = 0x60; 
  282   4                  }
  283   3              }
  284   2              else
  285   2              {
  286   3                  dwon_count = 0;
  287   3              }
  288   2      
  289   2              if (uart_rx_handlers[UART_1] != NULL)
  290   2              {
  291   3                  uart_rx_handlers[UART_1](uart_rx_buff[UART_1][0]);
  292   3              }
  293   2          }
  294   1      
  295   1          if (DMA_UR1R_STA & 0x02) // 数据丢弃
  296   1          {
  297   2              DMA_UR1R_STA &= ~0x02;      // 清标志位
  298   2              uart_rx_start_buff(UART_1); // 设置下一次接收，务必保留
  299   2              // 如果进入了这个中断，则代表UART的数据在没有取走之前被覆盖!
  300   2              // 如果进入了这个中断，则代表UART的数据在没有取走之前被覆盖!
  301   2              // 如果进入了这个中断，则代表UART的数据在没有取走之前被覆盖!
  302   2          }
  303   1      }
