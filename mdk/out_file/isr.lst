   40          void P0_IRQHandler() interrupt P0INT_VECTOR
   41          {
   42   1        uint8 i;
   43   1        volatile uint8 far *intf_reg = (volatile uint8 far *)(0x7efd10 + 0x00);//保存中断端口
   44   1        uint8 flags = *intf_reg;
   45   1        *intf_reg &= ~flags;
   46   1      
   47   1        for(i=0; i<8; i++)//查找中断
   48   1          {
   49   2              if(flags & (0x01 << i))
   50   2              {
   51   3                  gpio_int_irq_handlers[0x01][i]();
   52   3              }
   53   2          }
   54   1      }
