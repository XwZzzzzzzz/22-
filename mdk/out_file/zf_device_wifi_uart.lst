C251 COMPILER V5.60.0,  zf_device_wifi_uart                                                16/11/26  15:08:59  PAGE 15  

  910   1          wifi_uart_rx_head = 0;
  911   1          wifi_uart_rx_tail = 0;
  912   1      
  913   1      #if WIFI_UART_RTS_ENABLE
                   gpio_init(WIFI_UART_RTS_PIN, GPI, 1, GPI_PULL_UP);
               #endif
  916   1      #if WIFI_UART_HARDWARE_RST
                   gpio_init(WIFI_UART_RST_PIN, GPO, 1, GPO_PUSH_PULL);
               #endif
  919   1      
  920   1          /* 先用 115200（模块出厂默认）跟它建立通信 */
  921   1          /* ----------------------------------------------------------------
  922   1             依次尝试常见波特率，找出模块当前所在的档位
  923   1             原因：上一次运行时 AT+UART_CUR 会把模块改到别的波特率，
  924   1                   如果这里只试一个值，下次上电就会死锁（收不到 OK）
  925   1             ---------------------------------------------------------------- */
  926   1          {
  927   2              static const uint32 wifi_uart_probe_baud[] = {115200, 1500000, 921600, 460800, 230400, 9600};
  928   2              uint8 bi;
  929   2      
  930   2              for(bi = 0; bi < 6 && (0 == probe_ok); bi ++)
  931   2              {
  932   3                  uart_init(WIFI_UART_INDEX, wifi_uart_probe_baud[bi], WIFI_UART_TX_PIN, WIFI_UART_RX_PIN);
  933   3                  uart_rx_interrupt(WIFI_UART_INDEX, 1, wifi_uart_callback);
  934   3      
  935   3                  for(probe = 0; probe < 3; probe ++)
  936   3                  {
  937   4                      system_delay_ms(200);
  938   4                      wifi_uart_rx_clear();
  939   4                      uart_write_string(WIFI_UART_INDEX, "AT\r\n");
  940   4      
  941   4                      if(0 == wifi_uart_wait_ack("OK", 0, 300))
  942   4                      {
  943   5                          probe_ok = 1;
  944   5                          break;
  945   5                      }
  946   4                  }
  947   3      
  948   3                  printf("\r\n[wifi_uart] probe %d kHz -> ", (int)(wifi_uart_probe_baud[bi] / 1000));
  949   3                  if(probe_ok)    printf("OK\r\n");
  950   3                  else            printf("no\r\n");
  951   3              }
  952   2          }
  953   1      
  954   1          if(0 == probe_ok)                                       // 完全不回话，再试一次软复位
  955   1          {
  956   2              wifi_uart_reset();
  957   2              wifi_uart_rx_clear();
  958   2              uart_write_string(WIFI_UART_INDEX, "AT\r\n");
  959   2      
  960   2              if(0 == wifi_uart_wait_ack("OK", 0, 1000))
  961   2              {
  962   3                  probe_ok = 1;
  963   3                  printf("\r\n[wifi_uart] module ready after reset\r\n");
  964   3              }
  965   2          }
  966   1      
  967   1          if(0 == probe_ok)
  968   1          {
  969   2              printf("\r\n[wifi_uart] module no response: check TX/RX wiring and baud rate\r\n");
  970   2              return 1;
  971   2          }
  972   1          printf("\r\n[wifi_uart] module ready (probe %d)\r\n", probe + 1);
  973   1      
  974   1          do
  975   1          {
C251 COMPILER V5.60.0,  zf_device_wifi_uart                                                16/11/26  15:08:59  PAGE 16  

  976   2              /* 把模块串口改成目标波特率。流控填 0，因为主板一般没接 RTS */
  977   2              func_int_to_str(baud_rate, WIFI_UART_BAUD);
  978   2              if(wifi_uart_uart_config_set(baud_rate, "8", "1", "0", "0"))
