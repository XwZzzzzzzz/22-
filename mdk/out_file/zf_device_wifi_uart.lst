  895          /* ---------------------------------------------------------------- */
  896          /* 模块初始化                                                        */
  897          /* 参数：wifi_ssid  热点名称                                          */
  898          /*       pass_word  热点密码（无密码传 NULL 或 ""）                    */
  899          /*       wifi_mode  WIFI_UART_STATION / WIFI_UART_SOFTAP              */
  900          /* 返回：0-成功   1-失败                                              */
  901          /* ---------------------------------------------------------------- */
