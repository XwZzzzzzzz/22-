  756          /* ---------------------------------------------------------------- */
  757          /* 发送一段数据（普通模式）：AT+CIPSEND=n -> 等 > -> 发 n 字节        */
  758          /* ---------------------------------------------------------------- */
  759          static uint8 wifi_uart_send_once (const uint8 *buff, uint16 len)
  760          {
  761   1          static char lenth[16];
  762   1          uint8 state = 1;
  763   1      
  764   1          func_int_to_str(lenth, (int32)len);
  765   1      
  766   1          wifi_uart_rx_clear();
  767   1          uart_write_string(WIFI_UART_INDEX, "AT+CIPSEND=");
  768   1          uart_write_string(WIFI_UART_INDEX, lenth);
  769   1          uart_write_string(WIFI_UART_INDEX, "\r\n");
  770   1      
  771   1          if(0 == wifi_uart_wait_ack(">", "OK", WIFI_UART_ACK_TIMEOUT))   // 模块允许发送
  772   1          {
  773   2              wifi_uart_rx_clear();
  774   2              uart_write_buffer(WIFI_UART_INDEX, buff, len);
  775   2              if(0 == wifi_uart_wait_ack("SEND OK", "OK", WIFI_UART_ACK_TIMEOUT))
  776   2              {
  777   3                  state = 0;
C251 COMPILER V5.60.0,  zf_device_wifi_uart                                                16/11/26  15:08:59  PAGE 13  

  778   3              }
  779   2          }
  780   1          wifi_uart_rx_clear();
  781   1          return state;
  782   1      }
  783          
  784          /* ---------------------------------------------------------------- */
  785          /* 发送数据（对外接口）：自动按 WIFI_UART_SEND_ONCE 分块              */
  786          /* 返回剩余未发送的字节数，0 表示全部发完                             */
  787          /* ---------------------------------------------------------------- */
  788          uint32 wifi_uart_send_buffer (const uint8 *buff, uint32 len)
  789          {
  790   1          uint16 offset = 0;
  791   1          uint16 send_len;
  792   1          uint32 rest = len;
  793   1      
  794   1          if(WIFI_UART_SERVER_ON != wifi_uart_information.wifi_uart_connect_state)
  795   1          {
  796   2              return len;
  797   2          }
  798   1      
  799   1          if(WIFI_UART_COMMAND == wifi_uart_information.wifi_uart_transfer_mode)
  800   1          {
  801   2              while(rest > 0)
  802   2              {
  803   3                  send_len = (rest > WIFI_UART_SEND_ONCE) ? (uint16)WIFI_UART_SEND_ONCE : (uint16)rest;
  804   3                  if(wifi_uart_send_once(&buff[offset], send_len))
  805   3                  {
  806   4                      break;
  807   4                  }
  808   3                  offset += send_len;
  809   3                  rest   -= send_len;
  810   3              }
  811   2          }
  812   1          else
  813   1          {
  814   2              /* 透传模式：直接往串口丢，模块自己转发 */
  815   2      #if WIFI_UART_RTS_ENABLE
                       {
                           uint32 guard = 100000;
                           while(rest > 0)
                           {
                               guard = 100000;
                               while(gpio_get_level(WIFI_UART_RTS_PIN) && (0 < guard--));
                               uart_write_byte(WIFI_UART_INDEX, buff[offset]);
                               offset++;
                               rest--;
                           }
                       }
               #else
  828   2              uart_write_buffer(WIFI_UART_INDEX, buff, (uint16)rest);
  829   2              rest = 0;
  830   2      #endif
  831   2          }
  832   1          return rest;
  833   1      }
  834          
  835          /* ---------------------------------------------------------------- */
  836          /* 模块作为 TCP 服务器，指定客户端发送                               */
  837          /* ---------------------------------------------------------------- */
  838          uint32 wifi_uart_send_byte (const uint8 dat)
  839          {
  840   1          uint8 temp = dat;
  841   1      
  842   1          return wifi_uart_send_buffer(&temp, 1);
  843   1      }
C251 COMPILER V5.60.0,  zf_device_wifi_uart                                                16/11/26  15:08:59  PAGE 14  

  844          
  845          uint32 wifi_uart_send_string (const char *str)
  846          {
  847   1          return wifi_uart_send_buffer((const uint8 *)str, (uint32)strlen(str));
  848   1      }
